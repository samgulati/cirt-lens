# Copy to .env for local overrides. Never commit the resulting .env file.
ENVIRONMENT=development
AUTH_REQUIRED=false
APPROVAL_TTL_MINUTES=30
AUTH_MODE=local
AUTH_SECRET=replace-with-a-long-random-value
DEFAULT_TENANT_ID=tenant-demo

# OIDC public configuration. OIDC_JWKS_URL contains public signing keys.
OIDC_ISSUER=https://dev-7gml268v0z77w2wy.us.auth0.com/
OIDC_JWKS_URL=https://dev-7gml268v0z77w2wy.us.auth0.com/.well-known/jwks.json
OIDC_AUDIENCE=https://api.cirt-lens.local
OIDC_CLAIM_NAMESPACE=https://github.com/samgulati/cirt-lens
VITE_AUTH0_DOMAIN=dev-7gml268v0z77w2wy.us.auth0.com
VITE_AUTH0_CLIENT_ID=zl4YbdhokWzb6uuaJZaW4YcUT6u3dlOl
VITE_AUTH0_AUDIENCE=https://api.cirt-lens.local

POSTGRES_PASSWORD=replace-for-local-development
REDIS_URL=redis://localhost:6379/0

# Optional. Without this key, CIRT Lens uses its deterministic local investigator.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=sqlite:///./cirt_lens.db
CONNECTOR_MODE=fake
AUTH0_CONNECTOR_LIVE=false
AUTH0_ALLOWED_TARGET_USERS=
AUTH0_CONNECTOR_TARGET_USER=
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
IMPOSSIBLE_TRAVEL_WINDOW_MINUTES=60
MFA_FATIGUE_THRESHOLD=4
MFA_FATIGUE_WINDOW_MINUTES=10
UNUSUAL_EGRESS_BYTES=500000000
CORRELATION_WINDOW_MINUTES=60
CORRELATION_MIN_SCORE=5
